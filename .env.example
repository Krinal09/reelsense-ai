# ---- Live data provider (REQUIRED for real Reels): Apify, works for any public Reel, no user login ----
# Create a token at https://console.apify.com/settings/integrations  (free plan returns only ~15 comments; paid plan for more)
APIFY_TOKEN=
# LIVE_PROVIDER=auto            # auto | apify | graph
# APIFY_INCLUDE_REPLIES=false   # replies need a paid Apify plan

# ---- Alternative: official Instagram Graph API (own Business/Creator account's Reels only) ----
# Instagram Business/Creator account token with instagram_basic + instagram_manage_comments
IG_ACCESS_TOKEN=
IG_USER_ID=
# IG_GRAPH_VERSION=v21.0

# ---- Optional result store so GET /api/analysis/{id} works across invocations (Upstash Redis / Vercel KV) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Limits ----
MAX_COMMENTS=300
TIME_BUDGET_SECONDS=150
